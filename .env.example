# Copy to .env and adjust. Values below match this host (vm-mint21).

# Identity of the host user that starts the stack (id -u / id -g).
# Both the guard and the agent run as this uid/gid, so everything they
# create under dsh-workspace / dsh-data is owned by this user.
DSH_UID=1000
DSH_GID=1000

# Group that owns the host docker socket:
#   stat -c %g /var/run/docker.sock
# The guard needs this group to reach the daemon; nothing else does.
DOCKER_GID=

# Absolute host paths (compose cannot template them into the guard config).
DSH_DATA_DIR=/home/andy/Projects/dsh/dsh-data
DSH_WORKSPACE_DIR=/home/andy/Projects/dsh/dsh-workspace
DSH_GUARD_DIR=/home/andy/Projects/dsh/dsh-guard
DSH_HOME_DIR=/home/andy/Projects/dsh/dsh-home

# Agent image and published web port.
DSH_IMAGE=dsh:latest
DSH_DEV_TOOLS=none
DSH_PUBLIC_PORT=3080

# Optional guard hardening (see docker-guard/README.md):
# GUARD_FORCE_RUNTIME=runsc
# GUARD_MAX_MEMORY_BYTES=2147483648
# GUARD_MAX_PIDS=256
